# Copy to .env.local:  cp .env.example .env.local

# Unlayer project ID for the image editor. Optional: the demo ID below works for the
# full editor; a real ID with the AI-assistant entitlement additionally unlocks Unlayer's AI.
NEXT_PUBLIC_UNLAYER_PROJECT_ID=1234

# Public URL of the deployed site, used for social-share (Open Graph) links.
# On Vercel this is detected automatically; set it for custom domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
